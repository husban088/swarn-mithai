# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin emails (comma separated). Inhi emails se signup/signin karne par Admin panel khulega
# Pakistan admin = sirf Apna Pani (aqua) ka data, USA admin = sirf Mithai House (mithai) ka data
PK_ADMIN_EMAILS=wjahattahir@gmail.com
US_ADMIN_EMAILS=shahidmahmood73@hotmail.com

# Pakistan me sirf in emails ko Mithai dikhti hai (baqi sab ko Pakistan me sirf Aqua water)
PK_MITHAI_EMAILS=wjahattahir@gmail.com

# Nodemailer (Gmail: App Password use karein)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Mithai House <yourgmail@gmail.com>"

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Online payments abhi band hain. Chalu karne ke liye true karein
ONLINE_PAYMENTS=false

